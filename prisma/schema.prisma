generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  name                   String?
  image                  String?
  emailVerified          DateTime?
  // Phone login (production-aligned): phoneNumber is unique because it doubles
  // as a login identifier alongside email. phoneVerified is a timestamp marking
  // when the number was confirmed (null = unverified).
  phoneNumber            String?   @unique
  phoneVerified          DateTime?
  password               String?
  role                   UserRole  @default(FREE)
  bio                    String?
  apiKeys                Json?     @default("{}")
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  // Razorpay (Indian payment gateway — UPI, Google Pay, PhonePe)
  razorpaySubscriptionId String?   @unique
  razorpayPlanId         String?
  paymentGateway         String? // "stripe" | "razorpay"
  // Grandfathering: snapshot of old plan limits for existing users at time of
  // pricing migration. null = use current STRIPE_PLANS values (new signups).
  // Cleared on plan change (upgrade/downgrade) so user gets new plan's limits.
  legacyLimits           Json?     @map("legacy_limits")
  legacyLimitsSetAt      DateTime? @map("legacy_limits_set_at")
  // Timestamp of the user's last plan-tier change (upgrade or downgrade).
  // Used by check-execution-eligibility to scope paid-tier execution counts
  // so pre-upgrade FREE rows do not pollute post-upgrade quotas. Set to
  // now() by both webhook handlers (Razorpay + Stripe) on every role-change
  // event. Null for never-changed users (FREE since signup) — count-helper
  // treats null as "lifetime" for FREE and falls back to monthStart for
  // any orphan paid-tier rows without this field set.
  planChangedAt          DateTime? @map("plan_changed_at")
  // Gamification
  xp                     Int       @default(0)
  level                  Int       @default(1)

  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  accounts               Account[]
  achievements           UserAchievement[]
  publications           CommunityPublication[]
  communityVideos        CommunityVideo[]
  executions             Execution[]
  reviews                Review[]
  sessions               Session[]
  clones                 WorkflowClone[]
  feedbacks              Feedback[]
  quantityCorrections    QuantityCorrection[]
  workflows              Workflow[]
  referralsSent          Referral[]             @relation("ReferralsSent")
  referralsReceived      Referral[]             @relation("ReferralReceived")
  supportConversations   SupportConversation[]
  liveChats              LiveChatConversation[] @relation("UserLiveChats")
  videoShareLinks        VideoShareLink[]
  videoLikes             CommunityVideoLike[]
  survey                 UserSurvey?
  vipGenerations         VipGeneration[]
  vipJobs                VipJob[]
  videoJobs              VideoJob[]
  briefRenderJobs        BriefRenderJob[]
  canvasComments         CanvasComment[]        @relation("CanvasCommentAuthor")
  resolvedCanvasComments CanvasComment[]        @relation("CanvasCommentResolver")
  canvasGroups           CanvasGroup[]          @relation("CanvasGroupCreator")

  @@map("users")
}

model UserSurvey {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  discoverySource String?
  discoveryOther  String?
  profession      String?
  professionOther String?
  teamSize        String?
  pricingAction   String?
  completedAt     DateTime?
  skippedAt       DateTime?
  skippedAtScene  Int?
  // ── Attribution — first-touch only, never overwritten on auto-save ──
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmTerm         String?
  utmContent      String?
  referrer        String?
  country         String?
  city            String?
  deviceType      String?
  userAgent       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId])
  @@index([completedAt])
  @@index([createdAt])
  @@index([utmSource])
  @@index([country])
  @@map("user_surveys")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Workflow {
  id           String                 @id @default(cuid())
  ownerId      String
  name         String
  description  String?
  tags         String[]
  tileGraph    Json                   @default("{\"edges\": [], \"nodes\": []}")
  version      Int                    @default(1)
  isPublished  Boolean                @default(false)
  isTemplate   Boolean                @default(false)
  thumbnail    String?
  category     String?
  complexity   WorkflowComplexity     @default(SIMPLE)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  // Soft-delete marker. When set, the workflow is hidden from the owning
  // user's "My Workflows" view, but its row + all related Executions and
  // Artifact metadata are intentionally preserved so admin/audit pages
  // continue to show full historical activity. R2 storage is still wiped
  // by the bulk-delete endpoint when this is set.
  deletedAt    DateTime?
  publications CommunityPublication[]
  executions   Execution[]
  tiles        TileInstance[]
  clones       WorkflowClone[]
  versions     WorkflowVersion[]
  owner        User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  comments     CanvasComment[]
  groups       CanvasGroup[]

  @@index([ownerId])
  @@index([isTemplate])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("workflows")
}

model WorkflowVersion {
  id          String   @id @default(cuid())
  workflowId  String
  version     Int
  name        String
  description String?
  tileGraph   Json
  createdAt   DateTime @default(now())
  createdBy   String
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, version])
  @@index([workflowId])
  @@map("workflow_versions_history")
}

model TileInstance {
  id            String     @id @default(cuid())
  workflowId    String
  tileType      String
  positionX     Float      @default(0)
  positionY     Float      @default(0)
  configuration Json       @default("{}")
  createdAt     DateTime   @default(now())
  artifacts     Artifact[]
  workflow      Workflow   @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@map("tile_instances")
}

model Execution {
  id            String          @id @default(cuid())
  workflowId    String
  userId        String
  status        ExecutionStatus @default(PENDING)
  startedAt     DateTime?
  completedAt   DateTime?
  tileResults   Json            @default("[]")
  errorMessage  String?
  // Per-execution UI/state metadata (e.g. quantityOverrides for Task 2,
  // videoGenProgress for Task 3). Nullable JSON column written via
  // PATCH /api/executions/[id]/metadata. Stays null for executions
  // created before this column existed.
  metadata      Json?
  createdAt     DateTime        @default(now())
  artifacts     Artifact[]
  buildingModel BuildingModel?
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflow      Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([userId])
  @@index([createdAt])
  @@index([status])
  @@map("executions")
}

// Phase 1 Slice 7 — DB-canonical persistence of the parametric
// BuildingModel produced by the Python IFC service. The TS-side EX-001
// handler writes here when the Python response carries
// metadata.building_model_json. R2 holds the same JSON as a write-
// through replica (r2Key); DB is the source of truth, R2 is for cheap
// hot-reads + downstream pipelines (Phase 2 design agent input).
model BuildingModel {
  id           String    @id @default(cuid())
  executionId  String    @unique
  execution    Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  modelVersion String
  graph        Json
  r2Key        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([executionId])
  @@map("building_models")
}

model Artifact {
  id             String       @id @default(cuid())
  executionId    String
  tileInstanceId String
  type           ArtifactType
  dataUri        String?
  data           Json?
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now())
  execution      Execution    @relation(fields: [executionId], references: [id], onDelete: Cascade)
  tileInstance   TileInstance @relation(fields: [tileInstanceId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@index([tileInstanceId])
  @@map("artifacts")
}

model CommunityPublication {
  id           String   @id @default(cuid())
  workflowId   String
  authorId     String
  title        String
  description  String
  tags         String[]
  thumbnailUri String?
  ratingAvg    Float    @default(0)
  cloneCount   Int      @default(0)
  version      Int      @default(1)
  isFeatured   Boolean  @default(false)
  isReported   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  author       User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  workflow     Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  reviews      Review[]

  @@index([authorId])
  @@index([workflowId])
  @@index([ratingAvg])
  @@index([cloneCount])
  @@map("community_publications")
}

model Review {
  id            String               @id @default(cuid())
  publicationId String
  userId        String
  stars         Int
  comment       String?
  createdAt     DateTime             @default(now())
  publication   CommunityPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([publicationId, userId])
  @@map("reviews")
}

model WorkflowClone {
  id         String   @id @default(cuid())
  workflowId String
  userId     String
  sourceId   String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([userId])
  @@map("workflow_clones")
}

enum UserRole {
  FREE
  MINI
  STARTER
  PRO
  TEAM_ADMIN
  PLATFORM_ADMIN
}

enum WorkflowComplexity {
  SIMPLE
  INTERMEDIATE
  ADVANCED
}

enum ExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum ArtifactType {
  TEXT
  JSON
  IMAGE
  THREE_D
  FILE
  TABLE
  KPI
  VIDEO
}

// ─── Referral Program ─────────────────────────────────────────────

model Referral {
  id          String    @id @default(cuid())
  referrerId  String
  referredId  String?
  code        String    @unique
  status      String    @default("pending") // pending, completed
  rewardGiven Boolean   @default(false)
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  referrer    User      @relation("ReferralsSent", fields: [referrerId], references: [id], onDelete: Cascade)
  referred    User?     @relation("ReferralReceived", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([code])
  @@map("referrals")
}

// ─── Community Videos ──────────────────────────────────────────────

model CommunityVideo {
  id          String               @id @default(cuid())
  authorId    String
  title       String
  description String?
  category    String               @default("General")
  videoUrl    String
  duration    String?
  views       Int                  @default(0)
  likes       Int                  @default(0)
  isApproved  Boolean              @default(true)
  isFeatured  Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  author      User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likedBy     CommunityVideoLike[]

  @@index([authorId])
  @@index([createdAt])
  @@map("community_videos")
}

// Per-user like tracking for community videos. Joins users to videos they've
// liked so the like API can be idempotent and the GET /community-videos
// endpoint can return `isLikedByMe` per video. The `likes Int` counter on
// CommunityVideo above is kept as a denormalized display value, maintained
// transactionally alongside this table.
model CommunityVideoLike {
  id        String         @id @default(cuid())
  userId    String
  videoId   String
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     CommunityVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([videoId])
  @@index([userId])
  @@map("community_video_likes")
}

// ─── Gamification ──────────────────────────────────────────────────

model UserAchievement {
  id        String   @id @default(cuid())
  userId    String
  action    String
  xpAwarded Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, action])
  @@index([userId])
  @@map("user_achievements")
}

model FlashEventCompletion {
  id        String   @id @default(cuid())
  userId    String
  eventKey  String
  createdAt DateTime @default(now())

  @@unique([userId, eventKey])
  @@index([userId])
  @@map("flash_event_completions")
}

// ─── Beta Feedback ────────────────────────────────────────────────

model Feedback {
  id            String         @id @default(cuid())
  userId        String
  type          FeedbackType
  title         String
  description   String
  category      String?
  screenshotUrl String?
  status        FeedbackStatus @default(NEW)
  metadata      Json           @default("{}")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@map("feedback")
}

enum FeedbackType {
  BUG
  FEATURE
  SUGGESTION
}

enum FeedbackStatus {
  NEW
  REVIEWING
  PLANNED
  IN_PROGRESS
  DONE
  DECLINED
}

// ─── Demo Requests (inbound leads from /book-demo) ───────────────
//
// Every /book-demo form submission lands here alongside the email
// notifications, so admins have a persistent record (email is lossy —
// inboxes get cluttered, messages get archived, attribution is lost).
// Status drives the admin kanban: NEW → CONTACTED → SCHEDULED →
// COMPLETED (or CANCELLED if the lead goes cold).

model DemoRequest {
  id          String            @id @default(cuid())
  name        String
  email       String
  phone       String?
  company     String
  roleTitle   String? // job title / role — "Architect", "Principal", etc. (avoid collision with UserRole enum)
  message     String?
  status      DemoRequestStatus @default(NEW)
  adminNote   String? // admin's private notes about the lead
  contactedAt DateTime? // set when admin marks CONTACTED
  scheduledAt DateTime? // set when admin marks SCHEDULED
  completedAt DateTime? // set when admin marks COMPLETED
  // First-touch attribution — captured at submission time.
  ipAddress   String?
  userAgent   String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@map("demo_requests")
}

enum DemoRequestStatus {
  NEW
  CONTACTED
  SCHEDULED
  COMPLETED
  CANCELLED
}

// ─── Admin Dashboard ─────────────────────────────────────────────

model AdminAccount {
  id           String          @id @default(cuid())
  username     String          @unique
  passwordHash String
  displayName  String
  role         AdminRole       @default(ADMIN)
  isActive     Boolean         @default(true)
  sessionToken String?
  lastLoginAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  auditLogs    AdminAuditLog[]

  @@map("admin_accounts")
}

model AdminAuditLog {
  id         String        @id @default(cuid())
  adminId    String?
  admin      AdminAccount? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  details    Json          @default("{}")
  ipAddress  String?
  createdAt  DateTime      @default(now())

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  VIEWER
}

// ─── AI Roadmap Agent ────────────────────────────────────────────────

model AiRoadmap {
  id               String          @id @default(cuid())
  weekOf           DateTime
  summary          String
  riskFlags        String[]
  quickWins        String[]
  feedbackAnalysis Json            @default("{}")
  metricsSnapshot  Json            @default("{}")
  generatedBy      String?
  createdAt        DateTime        @default(now())
  tasks            AiRoadmapTask[]

  @@index([weekOf])
  @@index([createdAt])
  @@map("ai_roadmaps")
}

model AiRoadmapTask {
  id                String    @id @default(cuid())
  roadmapId         String
  title             String
  description       String
  priority          String // P0, P1, P2, P3
  effort            String // XS, S, M, L, XL
  category          String // bug-fix, feature, improvement, infra, dx, ux
  status            String    @default("todo") // todo, in-progress, done, deferred, dropped
  reasoning         String?
  linkedFeedbackIds String[]
  sortOrder         Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  roadmap           AiRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@index([roadmapId])
  @@index([status])
  @@map("ai_roadmap_tasks")
}

// QS Feedback Loop — stores quantity corrections from professional QS users
// Used to calibrate the IFC parser over time. Each correction improves future estimates.
model QuantityCorrection {
  id              String   @id @default(cuid())
  userId          String
  workflowId      String?
  elementType     String // "IfcWall", "IfcSlab", "IfcColumn", etc.
  buildingType    String // "commercial", "residential", "wellness", etc.
  city            String
  state           String
  extractedQty    Float // What the parser extracted
  correctedQty    Float // What the QS corrected to
  correctionRatio Float // corrected / extracted
  unit            String // "m²", "m³", "Rmt", "EA"
  notes           String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([elementType, buildingType, state])
  @@index([userId])
  @@index([createdAt])
  @@map("quantity_corrections")
}

// BOQ run analytics — every successful BOQ improves future estimates
model BOQAnalytics {
  id             String   @id @default(cuid())
  city           String
  state          String
  buildingType   String
  gfa            Float
  floors         Int
  costPerM2      Float
  materialRatio  Float
  laborRatio     Float
  masonRate      Float
  steelRate      Float
  cementRate     Float
  ifcQuality     String
  provisionalPct Float
  createdAt      DateTime @default(now())

  @@index([state, buildingType])
  @@index([createdAt])
  @@map("boq_analytics")
}

// ─── AI Support Chat System ──────────────────────────────────────

enum SupportStatus {
  ACTIVE
  ESCALATED
  ADMIN_REPLIED
  RESOLVED
  CLOSED
}

enum MessageRole {
  USER
  AI
  ADMIN
  SYSTEM
}

enum SupportCategory {
  GENERAL
  WORKFLOW_HELP
  NODE_EXECUTION
  BILLING
  BUG_REPORT
  FEATURE_REQUEST
  IFC_PARSING
  COST_ESTIMATION
  THREE_D_GENERATION
  ACCOUNT
  TECHNICAL
}

model SupportConversation {
  id            String          @id @default(cuid())
  userId        String
  status        SupportStatus   @default(ACTIVE)
  category      SupportCategory @default(GENERAL)
  subject       String?
  summary       String?
  priority      Int             @default(0)
  escalatedAt   DateTime?
  resolvedAt    DateTime?
  resolvedBy    String?
  assignedTo    String?
  satisfaction  Int?
  feedbackNote  String?
  pageContext   String?
  userPlan      String?
  messageCount  Int             @default(0)
  lastMessageAt DateTime        @default(now())
  metadata      Json            @default("{}")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([createdAt])
  @@index([lastMessageAt])
  @@index([assignedTo])
  @@map("support_conversations")
}

model SupportMessage {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  metadata       Json        @default("{}")
  isInternal     Boolean     @default(false)
  createdAt      DateTime    @default(now())

  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([role])
  @@index([createdAt])
  @@map("support_messages")
}

model SupportQuickReply {
  id         String          @id @default(cuid())
  title      String
  content    String
  category   SupportCategory @default(GENERAL)
  usageCount Int             @default(0)
  createdBy  String
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([category])
  @@map("support_quick_replies")
}

// ─── Live Chat (human-to-human support) ─────────────────────────────────────

enum LiveChatStatus {
  WAITING
  ACTIVE
  CLOSED
}

enum LiveChatRole {
  USER
  ADMIN
}

model LiveChatConversation {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation("UserLiveChats", fields: [userId], references: [id], onDelete: Cascade)
  status           LiveChatStatus    @default(WAITING)
  lastMessageAt    DateTime          @default(now())
  lastAdminReplyAt DateTime?
  repliedByAdminId String?
  repliedByName    String?
  closedByAdminId  String?
  closedAt         DateTime?
  pageContext      String?
  userPlan         String?
  messageCount     Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  messages         LiveChatMessage[]

  @@index([userId])
  @@index([status, lastMessageAt])
  @@index([lastMessageAt(sort: Desc)])
  @@map("live_chat_conversations")
}

model LiveChatMessage {
  id             String               @id @default(cuid())
  conversationId String
  conversation   LiveChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  senderRole     LiveChatRole
  senderName     String?
  content        String               @db.VarChar(3000)
  createdAt      DateTime             @default(now())

  @@index([conversationId, createdAt])
  @@map("live_chat_messages")
}

// ─── Video Share Links ──────────────────────────────────────────────────────
// Public, slug-addressed share links for generated walkthrough videos.
// Created via POST /api/share/video and consumed by app/share/[slug]/page.tsx.
// View count is incremented (best-effort) on each public page load.
model VideoShareLink {
  id          String    @id @default(cuid())
  slug        String    @unique
  videoUrl    String
  title       String?
  expiresAt   DateTime?
  viewCount   Int       @default(0)
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([createdById])
  @@index([createdAt])
  @@map("video_share_links")
}

/// Persistent material price cache — survives Redis TTL expiry.
/// Written after every successful TR-015 market intelligence fetch.
/// Queried by the price-fallback-chain when Redis cache misses.
/// Enables cross-user learning: once ANY user fetches prices for Pune,
/// ALL subsequent Pune BOQs benefit even if their own TR-015 fails.
model MaterialPriceCache {
  id           String   @id @default(cuid())
  city         String // e.g. "Pune"
  state        String // e.g. "Maharashtra"
  materialCode String // e.g. "steel_per_tonne", "cement_per_bag", "labor_mason"
  price        Float // numeric price in INR
  unit         String // e.g. "₹/tonne", "₹/bag", "₹/day"
  source       String // e.g. "market_intelligence", "user_correction"
  confidence   String // "HIGH", "MEDIUM", "LOW"
  fetchedAt    DateTime @default(now()) // when price was fetched
  expiresAt    DateTime // fetchedAt + 30 days

  // ── Provenance fields (Sprint 1 addition) ───────────────────────────────
  sourceUrl       String? // URL where price was found
  rawResponse     Json? // full AI/scraper response for audit
  confidenceScore Float? // 0-100 numeric confidence score
  method          String? // AI_SEARCH | PWD_TENDER | DEALER_PORTAL | CPWD_STATIC | USER_CORRECTION | INTERPOLATED

  @@index([city, materialCode, fetchedAt])
  @@index([state, materialCode, fetchedAt])
  @@index([materialCode, fetchedAt])
  @@map("material_price_cache")
}

// ─── VIP Pipeline Observability ─────────────────────────────────

enum VipGenerationStatus {
  RUNNING
  SUCCESS
  FALL_THROUGH
  FAILED
}

model VipGeneration {
  id                String              @id @default(cuid())
  userId            String
  requestId         String              @unique
  prompt            String
  status            VipGenerationStatus @default(RUNNING)
  pipelineUsed      String?
  stageTimings      Json?
  stageCosts        Json?
  stageErrors       Json?
  finalScore        Int?
  totalDurationMs   Int?
  totalCostUsd      Float?
  fallThroughReason String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("vip_generations")
}

// ─── VIP Background Jobs ────────────────────────────────────────

enum VipJobStatus {
  QUEUED
  RUNNING
  AWAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

model VipJob {
  id                String       @id @default(cuid())
  userId            String
  requestId         String       @unique
  prompt            String
  status            VipJobStatus @default(QUEUED)
  progress          Int          @default(0)
  currentStage      String?
  resultProject     Json?
  errorMessage      String?
  costUsd           Float        @default(0)
  startedAt         DateTime?
  completedAt       DateTime?
  // Phase 2.3 Workstream C: image approval gate.
  // When the worker completes Stage 2, it stores the stage1+stage2
  // outputs here as JSON, sets status=AWAITING_APPROVAL, and waits
  // for the user to click Approve (→ /api/vip-jobs/[id]/approve) or
  // Regenerate image (→ /api/vip-jobs/[id]/regenerate-image). A
  // second QStash message then picks up stages 3-7.
  pausedAt          DateTime?
  pausedStage       Int?
  intermediateImage String? // base64 of the Stage 2 GPT image
  intermediateBrief Json? // full stage 1 output (brief + imagePrompts)
  userApproval      String? // 'pending' | 'approved' | 'regenerating'
  // Phase 2.6: stage-by-stage log for the Pipeline Logs Panel UI.
  // Array of StageLogEntry objects — one entry per logStageStart /
  // logStageSuccess / logStageFailure hit by the orchestrator. Written
  // incrementally from the worker so the UI can poll and render each
  // stage as it completes. Shape defined in vip-pipeline/types.ts.
  stageLog          Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("vip_jobs")
}

// ─── Kling VideoJob Background Pipeline ─────────────────────────
//
// Backing store for the QStash-driven worker that replaces GN-009's
// client-side Kling polling. Each row represents one "video generation
// request" — a single-segment Omni task or a dual-segment image2video /
// text2video flow. Segments are stored as a JSON array on the row so
// we avoid a join table for a max-fanout of 2 segments per job.
//
// Ownership: userId FK is the durable check for /api/video-jobs/[id].
// executionId and nodeId are plain strings (not FKs) because the
// handler receives client-generated correlation IDs that do not
// necessarily match Execution.id at handler-invocation time — the
// same design the rest of the metadata/patching system uses.

model VideoJob {
  id String @id @default(cuid())

  // Association
  userId        String
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  executionId   String // client-correlation ID, not a FK
  // DB Execution.id when the workflow was persisted at run time (nullable —
  // unsaved / demo workflows run without a DB row). Plumbed through from the
  // client via useExecution → /api/execute-node body → handler ctx. Used by
  // advanceVideoJob at terminal transition to patch Execution.tileResults so
  // any non-VideoJob-aware reader (share endpoint, exports, etc.) still sees
  // a playable videoUrl on the artifact after the job completes.
  dbExecutionId String?
  nodeId        String // the workflow node instance that produced this job

  // Job identity / pipeline
  pipeline     String // "image2video" | "text2video" | "omni"
  isRenovation Boolean @default(false)
  isFloorPlan  Boolean @default(false)

  // Status machine
  status        String  @default("queued") // "queued" | "processing" | "partial" | "complete" | "failed"
  failureReason String? @db.Text

  // Segments — JSON array of VideoSegmentRecord (see src/types/video-job.ts)
  segments Json

  // Polling bookkeeping
  pollAttempts     Int       @default(0)
  lastPolledAt     DateTime?
  firstSubmittedAt DateTime  @default(now())

  // Final outputs (set when status transitions to complete or partial)
  totalDurationSeconds Int?
  costUsd              Float?

  // Label / metadata for the artifact
  buildingDescription String? @db.Text

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([userId])
  @@index([executionId])
  @@index([dbExecutionId])
  @@index([nodeId])
  @@index([status])
  @@index([status, lastPolledAt])
  @@map("video_jobs")
}

// ─── Brief-to-Renders Background Jobs ──────────────────────────
//
// Backing store for the "Brief-to-Renders" pipeline (Phase 1+).
// Each row is one user-initiated run: PDF/DOCX brief → spec extraction
// → user approval → N image renders → editorial PDF compile.
//
// Mirrors VipJob's status machine, stage log, and approval gate, with
// brief-renders-specific fields:
//   • briefUrl    — the input document on R2 (set at job creation)
//   • specResult  — Phase 2 BriefSpec JSON (every leaf nullable; strict
//                   faithfulness contract — no LLM invention)
//   • shots       — Phase 4 per-shot ShotResult[] (status, prompt,
//                   imageUrl, error). Updated in place by the worker
//                   as each shot completes; client polls for progress.
//   • pdfUrl      — Phase 5 final compiled PDF (R2 URL).
//
// Status machine matches VipJobStatus:
//   QUEUED → RUNNING → AWAITING_APPROVAL → RUNNING → COMPLETED
//                  └→ FAILED / CANCELLED
//
// Phase 1 only writes/reads `briefUrl` and the lifecycle columns —
// `specResult`, `shots`, and `pdfUrl` are populated in later phases.

enum BriefRenderJobStatus {
  QUEUED
  RUNNING
  AWAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

model BriefRenderJob {
  id           String               @id @default(cuid())
  userId       String
  requestId    String               @unique
  briefUrl     String
  status       BriefRenderJobStatus @default(QUEUED)
  progress     Int                  @default(0)
  currentStage String?
  // Phase 2 BriefSpec — strict-faithfulness JSON. Every leaf field is
  // either source-extracted from the brief or null. Shape defined in
  // src/features/brief-renders/services/brief-pipeline/types.ts.
  specResult   Json?
  // Phase 4 per-shot array — ShotResult[] (status, prompt, imageUrl,
  // error). Populated incrementally as the worker completes each shot.
  shots        Json?
  // Phase 5 final compiled PDF (R2 URL).
  pdfUrl       String?
  errorMessage String?
  costUsd      Float                @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  pausedAt     DateTime?
  // Spec-review approval gate. Status flips to AWAITING_APPROVAL after
  // Stage 2 (prompt-gen). Mirrors VipJob.userApproval semantics:
  //   'pending' | 'approved' | 'regenerating'
  userApproval String?
  // Stage-by-stage log for the Pipeline Logs Panel UI. Array of
  // BriefStageLogEntry — written incrementally from the worker so the
  // client can poll and render each stage as it completes. Shape
  // defined in src/features/brief-renders/services/brief-pipeline/types.ts.
  stageLog     Json?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("brief_render_jobs")
}

// ═══════════════════════════════════════════════════════════════════
// Z.BRIEF_TO_IFC_V2 — Phase 2 queued AI IFC-creation pipeline
// ═══════════════════════════════════════════════════════════════════
// One row per wf-13 ("Brief → AI-Powered IFC") queued run. The worker
// (QStash-invoked — src/app/api/brief-to-ifc-job/worker) advances the
// job through three Opus-4.7 stages — enrich → architect → generate —
// re-enqueuing itself between stages to reset Vercel's per-invocation
// budget. Mirrors BriefRenderJob's status-machine + stage-log shape.
// No formal `user` relation: a plain `userId` keeps this strictly
// additive — no back-relation field on the User model.

enum BriefToIfcJobStatus {
  QUEUED
  RUNNING_ENRICH
  RUNNING_ARCHITECT
  RUNNING_GENERATE
  COMPLETED
  FAILED
  AWAITING_RETRY
}

model BriefToIfcJob {
  id                String              @id @default(cuid())
  userId            String
  // Client-generated execution correlation id — links this job back to
  // the canvas Execution trace. Not a foreign key.
  executionId       String?
  status            BriefToIfcJobStatus @default(QUEUED)
  // R2 key/URL of the uploaded brief (PDF or DOCX).
  briefFileR2Key    String
  briefSourceFormat String?
  // Stage 1 output — the enriched, tender-grade Markdown spec.
  enrichedSpec      String?             @db.Text
  // Stage 2 output — JSON-encoded ArchitectScriptData (python_code +
  // expected_entity_count + summary + elements_emitted). Stage 3 parses
  // it back; stored whole so a future refinement loop keeps full context.
  architectScript   String?             @db.Text
  // Stage 3 output — the generated IFC.
  ifcR2Url          String?
  ifcEntityCount    Int?
  ifcAudit          Json?
  progress          Int                 @default(0)
  // Stable stage key — "enrich" | "architect" | "generate" (null while QUEUED).
  currentStage      String?
  // BriefToIfcStageLogEntry[] — written incrementally by the worker.
  stageLog          Json?
  // { code, message, stage } on failure.
  error             Json?
  // Global transient-retry counter across the whole job.
  attempts          Int                 @default(0)
  // Worker lock — set when a worker claims a stage, cleared on stage
  // success/failure. Guards against QStash at-least-once double-delivery
  // running the same stage twice. A lock older than the stage timeout is
  // considered stale and reclaimable / swept by the cleanup cron.
  lockedAt          DateTime?
  // Phase 3 — self-heal diagnostics ─────────────────────────────────
  // Full Python traceback (stderr_tail) from the last failing sandbox
  // run, kept VERBATIM so the user / repair Opus can pinpoint the bug.
  errorTraceback    String?             @db.Text
  // Compact classifier ("IFCOPENSHELL_RUNTIME_ERROR" | "INVALID_IFC" |
  // "MISSING_OUTPUT" | "SANDBOX_TIMEOUT" | ...). Distinct from
  // `error.code` because that's the whole-stage error code; this is
  // the inner sandbox/script failure label.
  errorType         String?
  // Stage-3 self-heal attempt counter (DISTINCT from the global
  // `attempts` transient-retry counter above). 0 → not yet attempted;
  // 1-3 → which of the up-to-three attempts we're on / finished on.
  attemptCount      Int                 @default(0)
  // BriefToIfcRetryAttempt[] — one entry per sandbox attempt, with
  // full scriptCode (so any failed version is downloadable), exit
  // code, durationMs, traceback. The original architect script is
  // retryHistory[0]; subsequent entries are Opus repair outputs.
  retryHistory      Json?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("brief_to_ifc_jobs")
}

// ─── Brief-to-IFC v3 — observability surface (Phase v3 hardening) ────
//
// v3 runs in a DEDICATED state machine — distinct from v2's
// `BriefToIfcJob` and from the canvas-tied `Execution`. The v3 lifecycle
// is "agent loop with tools" (one Run per generate call), not v2's
// three-stage queue OR v1's per-tile artifact map.
//
// Sharing tables across pipelines would conflate three different state
// machines; keeping v3 isolated lets the observability layer (status
// transitions, heartbeat, error-code enum, log stream) ship strictly
// "v3 only" per the Phase observability spec Rule 8.

enum BriefToIfcV3RunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model BriefToIfcV3Run {
  id                String                @id @default(cuid())
  userId            String
  workflowId        String? // optional — caller correlation, not enforced
  status            BriefToIfcV3RunStatus @default(PENDING)
  // Snapshot of the BriefSpec the agent operated on (post-Layer 1
  // enrichment, or the user-supplied briefSpec if Layer 1 was skipped).
  briefSpec         Json
  // Layer 1 telemetry — null when caller passed `briefSpec` directly.
  enrichmentCostUsd Float?
  enrichmentMs      Int?
  // Layer 2 (generator) telemetry. Populated incrementally by the
  // background runner so a stuck run still has the partial ledger
  // visible in the diagnostic CLI.
  generatorCostUsd  Float                 @default(0)
  generatorMs       Int                   @default(0)
  turns             Int                   @default(0)
  ledger            Json                  @default("[]") // AgentTokenLedgerEntry[]
  turnRecords       Json                  @default("[]") // AgentTurnRecord[]
  // Final IFC artifact. Set ONLY when status=COMPLETED.
  ifcUrl            String?
  entityCount       Int?
  finalValidation   Json?
  // Failure detail. Set ONLY when status=FAILED (or CANCELLED).
  // `errorCode` MUST be a member of BRIEF_TO_IFC_V3_ERROR_CODES;
  // refusal is enforced at the `transitionStatus()` helper.
  errorCode         String?
  errorMessage      String?
  // Liveness — set by the background runner's heartbeat ticker every
  // ~5s. A sweep job marks RUNNING rows whose lastHeartbeatAt is
  // older than 5 min as FAILED with code STUCK_NO_HEARTBEAT.
  lastHeartbeatAt   DateTime?
  // Cost cap honoured by the run (echoed back for audit).
  costCapUsd        Float?
  // Cost-cap-exceeded short-circuit and other partial-ledger results
  // keep these intermediate fields trustworthy at any moment in time.
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  // Phase δ.3 — per-iteration chaining state.
  //
  // currentIteration is the atomic check-and-set counter that
  // serialises QStash hops: each worker invocation only proceeds if it
  // can atomically advance the counter from N-1 to N via a conditional
  // updateMany. Duplicate QStash deliveries fail the update and become
  // no-ops, giving exactly-once iteration semantics at the DB layer.
  //
  // iterationHistory carries per-iteration results across hops so the
  // worker can compute best-so-far and the final COMPLETED transition
  // can write the highest-quality iteration's artifacts (never a
  // regressed later iteration).
  //
  // bestIteration is the 1-based iteration number of the best result
  // (matches iterationHistory[i].iteration). Authoritative for which
  // ifcUrl/entityCount/finalValidation got written into the COMPLETED
  // row's user-facing fields.
  currentIteration  Int                   @default(0)
  iterationHistory  Json                  @default("[]")
  bestIteration     Int?

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@index([workflowId])
  @@index([lastHeartbeatAt])
  @@map("brief_to_ifc_v3_runs")
}

/// Per-user monthly counters for Brief-to-IFC v3 quota enforcement.
///
/// Lazy-reset semantics: the application checks `currentMonthStart` on
/// each call and resets `runsThisMonth` + `costThisMonthUsd` if a new
/// calendar month has begun. No cron required.
///
/// `runsThisMonth` is incremented atomically as part of run creation in
/// POST /api/brief-to-ifc/v3/runs. Defaults per role come from
/// `getBriefToIfcV3MonthlyLimit` in plan-data.ts.
model BriefToIfcV3UserQuota {
  id                String   @id @default(cuid())
  userId            String   @unique
  /// First day of the month this counter belongs to, at 00:00 UTC.
  /// When the wall clock crosses into a new month, the next call
  /// rewrites this to the new month-start and zeros the counters.
  currentMonthStart DateTime @default(now())
  runsThisMonth     Int      @default(0)
  costThisMonthUsd  Float    @default(0)
  updatedAt         DateTime @updatedAt

  @@map("brief_to_ifc_v3_user_quotas")
}

// Structured execution log. `executionId` is a plain string column,
// NOT a Prisma relation, so the same table can carry logs for any
// future execution shape (v2 job, v3 run, future v4) without a
// polymorphic FK kludge. Index makes per-run timeline retrieval fast.
model ExecutionLog {
  id          String   @id @default(cuid())
  executionId String
  // INFO | WARN | ERROR | DEBUG — kept as a plain string so callers
  // can't typo their way into a 500. Enforced at appendLog().
  level       String
  // Free-form source label so the dashboard can group logs by stage.
  // Common values: ENRICH | GENERATE | TOOL_CALL | SANDBOX |
  // HEARTBEAT | LIFECYCLE | DIAGNOSTIC.
  source      String
  message     String   @db.Text
  // Structured metadata — tool input/output, token counts, durations.
  // Kept Json? so a log line with no metadata stays cheap.
  metadata    Json?
  timestamp   DateTime @default(now())

  @@index([executionId, timestamp])
  @@map("execution_logs")
}

// ═══════════════════════════════════════════════════════════════════
// Z.CANVAS.SCHEMA — Canvas Collaboration Models
// ═══════════════════════════════════════════════════════════════════

model CanvasComment {
  id           String          @id @default(cuid())
  workflowId   String
  workflow     Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  authorId     String
  author       User            @relation("CanvasCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       CanvasComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      CanvasComment[] @relation("CommentReplies")
  body         String          @db.Text
  mentions     String[]
  positionX    Float
  positionY    Float
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?           @relation("CanvasCommentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([workflowId])
  @@index([authorId])
  @@index([parentId])
  @@map("canvas_comments")
}

model CanvasGroup {
