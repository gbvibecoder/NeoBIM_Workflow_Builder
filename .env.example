THREE_D_AI_STUDIO_API_KEY="your_3dai_studio_api_key_here"

# ============================================================
# CLOUDFLARE R2 (https://dash.cloudflare.com → R2)
# Free: 10GB storage, 10M reads/mo, 1M writes/mo
# Stores generated PDFs & XLSX files with 25-day auto-cleanup
# If not configured, files fall back to base64 data URI (still works)
# ============================================================
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="buildflow-files"
R2_PUBLIC_URL="https://pub-xxx.r2.dev"

# Secret for cron cleanup endpoint (generate: openssl rand -base64 32)
CRON_SECRET="your-cron-secret"

# ============================================================
# APP CONFIGURATION
# ============================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set to "true" for local dev without API keys — uses mock execution results
NEXT_PUBLIC_ENABLE_MOCK_EXECUTION="true"

# ============================================================
# RATE LIMITS (optional, defaults shown — all monthly)
# ============================================================
FREE_TIER_EXECUTIONS_PER_MONTH="2"
MINI_TIER_EXECUTIONS_PER_MONTH="10"
STARTER_TIER_EXECUTIONS_PER_MONTH="30"
PRO_TIER_EXECUTIONS_PER_MONTH="100"

# ============================================================
# ADMIN (optional — comma-separated emails that bypass rate limits)
# ============================================================
ADMIN_EMAILS="admin@example.com"

# ============================================================
# ADMIN PANEL SETUP (required for first admin account creation)
# On first launch with no admin accounts, these are used to seed
# a SUPER_ADMIN. After setup, you may remove ADMIN_SETUP_PASSWORD.
# ============================================================
ADMIN_SETUP_USERNAME="your_admin_username"
ADMIN_SETUP_PASSWORD="YourSecurePassword123!"

# ============================================================
# GOOGLE TAG MANAGER (https://tagmanager.google.com)
# Lets marketing deploy tags (GA4, Ads, LinkedIn, etc.) without code changes
# ============================================================
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"

# ============================================================
# META (FACEBOOK) PIXEL
# Pixel ID is hardcoded as a fallback in src/lib/meta-pixel.ts +
# src/lib/server-conversions.ts so the app works without env config.
# Override with env vars to rotate the Pixel without a redeploy.
# Both vars should resolve to the same Pixel ID.
# ============================================================
NEXT_PUBLIC_META_PIXEL_ID="2072969213494487"
META_PIXEL_ID="2072969213494487"

# ============================================================
# META CONVERSIONS API (https://developers.facebook.com/docs/marketing-api/conversions-api)
# Server-side conversion tracking — bypasses ad blockers for 100% accuracy.
# Generate token: Business Settings → System Users → Generate Token (ads_management)
# Without this, every server CAPI call silently no-ops (see server-conversions.ts:52).
# ============================================================
META_CAPI_ACCESS_TOKEN=""

# ============================================================
# META TRACKING ENVIRONMENT GATE
# By default, Meta Pixel + CAPI fire ONLY from the production domain
# (trybuildflow.in). Localhost, *.vercel.app previews, and staging are
# blocked so Meta's algorithm doesn't train on dev/QA traffic. Leave
# the two FORCE vars unset for normal use. Set them ONLY for explicit
# staging smoke tests (e.g. verifying a new event fires end-to-end on
# a Vercel preview before merging). See src/lib/tracking-env.ts.
# ============================================================
# NEXT_PUBLIC_META_TRACKING_FORCE="true"   # browser-side override
# META_TRACKING_FORCE="true"               # server-side override

# ============================================================
# GOOGLE ANALYTICS 4 (https://analytics.google.com)
# Tracks sessions, page views, audience demographics, conversions
# ============================================================
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# ============================================================
# GOOGLE ADS (https://ads.google.com)
# Conversion tracking (AW-…). Shares dataLayer with GA4/GTM.
# Consent Mode v2 gates ad_storage / ad_user_data / ad_personalization.
# Conversion labels come from Google Ads → Tools → Conversions → <action> → "Tag setup"
# Format is "AW-XXXXXXXXXX/aBcDeFgHiJ". Fired via trackAdsConversion().
# ============================================================
NEXT_PUBLIC_GOOGLE_ADS_ID="AW-XXXXXXXXXX"
NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL="AW-XXXXXXXXXX/signup_label_here"
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL="AW-XXXXXXXXXX/purchase_label_here"

# ============================================================
# AUTOSEND (https://autosend.com)
# Transactional emails: welcome, verification, payment failed, plan changes
# Hobby plan: $1/month, 3000 emails/month
# ============================================================
AUTOSEND_API_KEY="AS_..."
AUTOSEND_FROM_EMAIL="noreply@yourdomain.com"
AUTOSEND_FROM_NAME="BuildFlow"

# ============================================================
# MICROSOFT CLARITY (https://clarity.microsoft.com)
# Heatmaps, session recordings, and user behavior analytics
# ============================================================
NEXT_PUBLIC_CLARITY_PROJECT_ID="vx5sglywjv"

# Anthropic API (Claude) — Market Intelligence Agent (TR-015) + floor plan analysis
# Must be an API key (sk-ant-api03-...), NOT an OAuth token (sk-ant-oat...).
# Get one from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ============================================================
# SENTRY (https://sentry.io)
# Error tracking and performance monitoring
# ============================================================
NEXT_PUBLIC_SENTRY_DSN=

# ============================================================
# RAZORPAY (https://razorpay.com)
# Indian payment gateway: UPI, Google Pay, PhonePe, net banking
# Create plans in Dashboard → Payment Products → Subscriptions → Plans
# ============================================================
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your-razorpay-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"
RAZORPAY_MINI_PLAN_ID="plan_..."
RAZORPAY_STARTER_PLAN_ID="plan_..."
RAZORPAY_PRO_PLAN_ID="plan_..."
RAZORPAY_TEAM_PLAN_ID="plan_..."
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."
SENTRY_AUTH_TOKEN=

# ============================================================
# BILLING FEATURE FLAGS (optional — all default false)
# ============================================================
# Master switch for the cancel-grace-window code paths. When "false"
# (default), cancel webhooks fall through to the legacy immediate-downgrade
# behaviour. When "true", cancel webhooks preserve role until the paid
# period (stripeCurrentPeriodEnd) actually expires; the hourly cron at
# /api/cron/billing-grace-window-sweep then downgrades. Flip to "true"
# only after the restore script has run cleanly in production.
BILLING_GRACE_WINDOW_ENABLED="false"

# ============================================================
# FLOOR PLAN PIPELINE FLAGS (optional — all default false)
# ============================================================
# PIPELINE_VIP: Visual Intelligence Pipeline (Approach #17).
# When true, VIP runs first for all prompts. Falls through to
# PIPELINE_REF on any failure. Default: false.
PIPELINE_VIP="false"

# PIPELINE_VIP_JOBS: Async VIP job queue (Phase 1.9).
# When true, POST /api/vip-jobs accepts new background VIP jobs.
# Requires QStash env vars below. Default: false.
PIPELINE_VIP_JOBS="false"

# VIP Pipeline Canary Rollout (Phase 1.11b)
# Comma-separated emails that get VIP when PIPELINE_VIP_JOBS=true.
# Case-insensitive. Empty = nobody gets VIP (even with flag on).
VIP_BETA_EMAILS=""

# Platform admin emails that ALWAYS see VIP when flag is on
# (regardless of VIP_BETA_EMAILS). For production testing.
VIP_ADMIN_OVERRIDE_EMAILS=""

# ============================================================
# BRIEF-TO-RENDERS PIPELINE (optional — all default false/empty)
# ============================================================
# PIPELINE_BRIEF_RENDERS: master switch for the Brief-to-Renders
# pipeline (PDF/DOCX brief → spec extraction → N image renders →
# editorial PDF). When false/unset, the dashboard page 404s and
# /api/config/feature-flags returns briefRendersEnabled:false for
# every user. Default: false.
# PIPELINE_BRIEF_RENDERS="false"

# Comma-separated beta allowlist. Case-insensitive. Empty = nobody
# (even when the master switch is on).
# BRIEF_RENDERS_BETA_EMAILS=""

# Admin emails that ALWAYS see Brief-to-Renders when the master
# switch is on (regardless of BRIEF_RENDERS_BETA_EMAILS).
# BRIEF_RENDERS_ADMIN_OVERRIDE_EMAILS=""

# ============================================================
# UPSTASH QSTASH (https://upstash.com/qstash)
# Background job scheduling for VIP pipeline (Phase 1.9+).
# Get credentials from Upstash Console → QStash tab.
# ============================================================
QSTASH_URL="https://qstash.upstash.io"
QSTASH_TOKEN="your-qstash-token"
QSTASH_CURRENT_SIGNING_KEY="your-qstash-signing-key"
QSTASH_NEXT_SIGNING_KEY="your-qstash-next-signing-key"

# ============================================================
# === KOS (Kalzen Operating System) ===
# Week 1 foundation — values stay empty / placeholder until the
# corresponding feature wires light up (S3 in Week 2, AiSensy in
# Week 4, Frappe in Week 5). The seed script (`npm run seed:kos`)
# stores ONLY env var NAMES on the Tenant row, never the values
# themselves, so secrets stay in this layer.
# ============================================================

# AWS S3 Mumbai (ap-south-1) — Kalzen documents + customer drawings.
# Bucket name + region live on the Tenant.s3Config row (default:
# `kalzen-kos-prod` / `ap-south-1`). These env vars are looked up at
# runtime via the `*Ref` names stored on the tenant.
KOS_S3_ACCESS_KEY_ID=
KOS_S3_SECRET_ACCESS_KEY=

# AiSensy WhatsApp BSP (chosen over direct Meta to skip the ~7-day
# Business Manager verification). Will be populated in Week 4 when
# the WhatsApp transport goes live.
AISENSY_API_KEY_KALZEN=
AISENSY_WEBHOOK_VERIFY_TOKEN_KALZEN=
WHATSAPP_PHONE_NUMBER_KALZEN=

# Frappe CRM — Kalzen instance. baseUrl lives on Tenant.frappeConfig
# (currently null; populate via the seed or admin UI once Karthik
# provisions the instance). API key/secret stay in env.
FRAPPE_API_KEY_KALZEN=
FRAPPE_API_SECRET_KALZEN=
FRAPPE_BASE_URL_KALZEN=

# KOS session signing — used by the dedicated KosCustomer / KosBdUser
# session cookies (Week 5). Generate with `openssl rand -base64 32`.
# DO NOT reuse NEXTAUTH_SECRET — keep KOS auth keys independent of
# BuildFlow auth so rotating one cannot lock anyone out of the other.
KOS_SESSION_SECRET=

# Used only by prisma/seed-kos-bd.ts — never read at runtime.
# Run `npm run seed:kos-bd` to upsert a BD user with these credentials
# into the Kalzen tenant. Re-running with the same email refreshes
# the password hash.
KOS_BD_SEED_EMAIL=
KOS_BD_SEED_PASSWORD=

# Optional — set to "true" to expose the BD-only dev test-retrieval
# endpoint (/api/kos/bd/dev/test-retrieval) in production. Off by
# default everywhere except NODE_ENV=development.
KOS_DEV_ENDPOINTS_ENABLED=

# DEV-ONLY: run the KOS ingestion worker in-process when
# /api/kos/bd/documents/[id]/confirm-upload returns, instead of
# publishing a job to QStash. Required for local dev because QStash
# cannot POST to localhost:3000. The runtime ignores this flag when
# NODE_ENV === "production" — production ALWAYS uses QStash. Do not
# enable on Vercel or any internet-routable deploy.
KOS_DEV_INLINE_WORKER=

# DEV-ONLY DIAGNOSTIC: route retrieveChunks() through a plain
# `vector` cosine sequential scan instead of the halfvec HNSW fast
# path. Useful to isolate whether a `prisma:error undefined` failure
# is in the operator/index class vs the literal builder. Slow on any
# non-trivial corpus — flip on to investigate, flip off to ship.
# Ignored when NODE_ENV === "production".
KOS_RAG_FALLBACK_SCAN=

# DEV-ONLY DIAGNOSTIC: skip embed + vector cast entirely. retrieveChunks
# returns chunks scoped by tenantId + status='READY' with similarity=0.5
# hard-coded. Use to confirm whether vector binding is the failure mode:
#   rows returned → vector binding is the problem
#   still fails  → connection / auth / schema, not vector
# Ignored when NODE_ENV === "production".
KOS_RAG_DIAG_NO_VECTOR=

# DEV-ONLY DIAGNOSTIC: choose how the vector parameter is sent across
# the Neon WebSocket protocol. Values:
#   text   (default) — JS string, ::halfvec(3072) cast.
#   buffer           — Buffer.from(literal, "utf8"). Same bytes,
#                      different protocol shape.
#   array            — raw number[] (3072 floats). Most likely fails
#                      because pgvector wants text/float4[] input —
#                      include only to rule out the codec.
# Ignored when NODE_ENV === "production" (always uses "text" there).
KOS_RAG_PARAM_MODE=

# Neon's non-pooled direct endpoint. Recommended for scripts under
# scripts/ (cleanup, retrieval test) — the pooled DATABASE_URL is
# what the Vercel runtime uses, but the `pg`-driver scripts work
# more reliably against the direct endpoint. If unset, scripts fall
# back to DATABASE_URL with a warning.
DIRECT_URL=

# Used by `npm run kos:test-retrieval -- --via-api` to authenticate
# against the BD console without a browser session. Generate via
# `npm run kos:bd-session` (which uses KOS_BD_SEED_* to log in and
# prints the cookie value back). Dev-only; never set in production.
KOS_DEV_BD_SESSION_TOKEN=

# Base URL of the Next dev server (for the BD-session helper + the
# --via-api test path). Defaults to http://kalzen.localhost:3000 when
# unset, which matches the dev-mode <slug>.localhost subdomain rule.
KOS_DEV_API_BASE_URL=

# === KOS BIM ingestion — Autodesk APS (Platform Services) (Week 5A) ===
# Server-to-server (Client Credentials grant) app from
# https://aps.autodesk.com. Translates Revit .rfa / AutoCAD .dwg into
# SVF2 + a properties manifest so we can extract panel/accessory SKU
# parameters. FREE-tier credits cover the 5-file pipeline test. NEVER
# hardcode these — the BIM constants module reads them from env at boot.
APS_CLIENT_ID=<your-client-id>
APS_CLIENT_SECRET=<your-client-secret>
# APS OSS bucket. Lowercase alphanumeric + hyphens only; must be GLOBALLY
# unique across all of Autodesk (a 409 means someone took the name —
# change it). Defaults to "kos-buildflow-bim-dev" if unset.
APS_BUCKET_KEY=kos-buildflow-bim-dev
# Bucket retention: transient (24h) | temporary (30d) | persistent.
# "transient" is correct for the test pipeline — translations are cached
# in our own DB/S3, the APS object is disposable. Defaults to transient.
APS_BUCKET_POLICY=transient

# === KOS BIM behavior ===
# Absolute path to the local Dincel/Kalzen family package (the folder
# containing profiles/ vertical/ horizontal/ systems/ + the catalog .dwg).
KOS_BIM_LOCAL_PACKAGE_PATH=/Users/govindbhujbal/Desktop/package_a
# When true the test-ingest script honors KOS_BIM_TEST_FILE_LIMIT (5).
# Default false. The script's --limit flag overrides this either way.
KOS_BIM_TEST_MODE=true
# APS hard cap is ~200MB; files larger than this are rejected before any
# upload (KOS_APS_004_TOO_LARGE) so we never burn an upload on a doomed file.
KOS_BIM_MAX_FILE_SIZE_MB=200
